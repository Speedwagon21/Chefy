# Copy to .env (or set these in your host's dashboard). Leave the Stripe keys empty for demo payments.
PORT=3000
NODE_ENV=production
# Full public address of the app, used for Stripe return links and secure cookies
PUBLIC_URL=https://your-app.example.com
# Admins are not set here. Sign up in the app, then run:  npm run make-admin -- you@example.com
# Where the database and uploaded photos live. Must be on a persistent disk in production.
DATA_DIR=./data

# Stripe (https://dashboard.stripe.com/test/apikeys). Turn on Connect in the dashboard first.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From Developers > Webhooks: endpoint https://your-app.example.com/api/stripe/webhook
# Events: payment_intent.amount_capturable_updated, payment_intent.canceled, account.updated
STRIPE_WEBHOOK_SECRET=
